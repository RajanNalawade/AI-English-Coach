# Copy to deploy/.env (setup.sh does this for you) and fill in.

# Your server's public IP with dots, then .sslip.io, e.g. 140.238.12.34.sslip.io
DOMAIN=

# Login for the app. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# and keep the single quotes around the hash below.
COACH_USER=coach
COACH_PASSWORD_HASH=''

COACH_MODEL=qwen3:4b
COACH_STT_MODEL=base
