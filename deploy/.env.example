# Copy to deploy/.env (setup.sh does this for you) and fill in.

# Your server's public IP with dots, then .sslip.io, e.g. 140.238.12.34.sslip.io
DOMAIN=

# Login for the app. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# and keep the single quotes around the hash below.
COACH_USER=coach
COACH_PASSWORD_HASH=''

COACH_MODEL=qwen3:4b
COACH_STT_MODEL=base

# Optional: send AI requests to a hosted open model first, with the local
# Ollama model as the fallback. Leave COACH_LLM_PROVIDER=ollama to stay free
# and fully private. With "openai", your text goes to that provider.
# Any OpenAI-compatible API works, e.g.
#   DeepInfra:  https://api.deepinfra.com/v1/openai
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
# Check the provider's model page for the exact model name. Prefer prepaid
# credits with auto top-up off, so the bill can never surprise you.
COACH_LLM_PROVIDER=ollama
COACH_REMOTE_URL=
COACH_REMOTE_API_KEY=
COACH_REMOTE_MODEL=
